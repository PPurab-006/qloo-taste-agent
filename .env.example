# ==============================================================================
# VELLUM: Cultural Intelligence Engine Configuration
# ==============================================================================

# Qloo API Key (Required for live upstream requests)
# Request a hackathon key at: https://forms.gle/zz12orkLHTAneLGz6
# When empty or omitted, Vellum operates in transparent Mock / Demonstration mode
# with realistic canonical entities and real taste-graph affinity structures.
QLOO_API_KEY=your_qloo_hackathon_api_key_here

# Qloo Base URL
# Default for hackathon keys: https://hackathon.api.qloo.com
# For production keys: https://api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Request timeout in milliseconds (default: 10000ms = 10s)
QLOO_TIMEOUT_MS=10000

# Cache TTL in milliseconds for server-side Qloo queries (default: 300000ms = 5 minutes)
QLOO_CACHE_TTL_MS=300000

# Optional: Gemini API Key for dynamic narrative synthesis
# If omitted, Vellum uses deterministic, grounded editorial synthesis from Qloo signals.
GEMINI_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
